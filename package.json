{
  "name": "rmdex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "agent": "tsx server/index.ts",
    "relay": "tsx server/relay/index.ts",
    "build:relay": "esbuild server/relay/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-relay/index.js",
    "test:relay": "tsx server/relay/relay.test.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^15.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
