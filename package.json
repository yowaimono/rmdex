{
  "name": "rmdex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "agent": "tsx server/index.ts",
    "desktop:register": "tsx scripts/register-desktop.ts",
    "desktop:probe": "node scripts/probe-desktop.mjs",
    "desktop:shared": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-shared-session.ps1",
    "desktop:shared:manual": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-shared-manual.ps1",
    "pc:build": "vite build --config pc-vite.config.ts",
    "pc:server": "tsx pc/server.ts",
    "pc:start": "npm run pc:build && npm run pc:server",
    "test:desktop": "node --import tsx --test server/desktop.test.mjs",
    "relay": "tsx server/relay/index.ts",
    "build:relay": "esbuild server/relay/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-relay/index.js",
    "test:relay": "tsx server/relay/relay.test.ts",
    "test:shared": "node --import tsx --test server/shared.integration.test.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "mcp": "tsx server/control-mcp.ts",
    "test:mcp": "node --import tsx --test server/control-mcp.test.mjs",
    "pc:window:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-pc-window.ps1",
    "test:pc": "node --test pc/launcher.test.mjs",
    "release:android": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "release:pc": "npm run pc:build && npm run pc:window:build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-pc-msi.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^15.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
